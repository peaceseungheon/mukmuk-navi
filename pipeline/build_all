#!/usr/bin/env bash
# D6: 통합 빌드 — ①추출 → ②그래프 컴파일 → ③mbtiles → ④POI sqlite → ⑤스모크 → ⑥manifest → ⑦zip
#
# 기존 개별 스크립트를 호출만 한다(로직 복제 없음).
# ⑤ 스모크가 실패하면 ⑥ 이후를 실행하지 않는다.
# ⑥ manifest 를 먼저 쓰고 ⑦ zip 에 포함한다(압축본에 manifest.json 이 있어야 앱이 팩을 검증할 수 있음).
#
# 사용법:
#   pipeline/build_all [--out DIR] [--work DIR] [--pack-version YYYY.MM] [--skip-extract]
#
# 환경변수: SAMPLE_BBOX, OSM_PBF, OSM_URL, MBTILES_BOUNDS, MBTILES_CENTER, PACK_VERSION, CARGO
set -euo pipefail

ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
OUT="$ROOT/data/sample"
WORK="$ROOT/data/work/sample"
PACK_VERSION="${PACK_VERSION:-$(date -u +%Y.%m)}"
SKIP_EXTRACT=0
CARGO_BIN="${CARGO:-}"

die() { echo "ERROR: $*" >&2; exit 1; }

while [[ $# -gt 0 ]]; do
  case "$1" in
    --out) OUT="$2"; shift 2 ;;
    --work) WORK="$2"; shift 2 ;;
    --pack-version) PACK_VERSION="$2"; shift 2 ;;
    --skip-extract) SKIP_EXTRACT=1; shift ;;
    -h|--help) sed -n '2,12p' "$0"; exit 0 ;;
    *) die "알 수 없는 인자: $1" ;;
  esac
done

PYTHON_BIN="$(command -v python3 || command -v python || true)"
[[ -n "$PYTHON_BIN" ]] || die "python 3 필요"

# 이전 팩 총 크기(±30% 경고용). manifest 를 덮어쓰기 전에 읽는다.
PREV_TOTAL=0
if [[ -f "$OUT/manifest.json" ]]; then
  PREV_TOTAL="$("$PYTHON_BIN" - "$OUT/manifest.json" <<'PY'
import json, sys
m = json.load(open(sys.argv[1], encoding="utf-8"))
print(sum(f.get("size", 0) for f in m.get("files", {}).values()))
PY
)"
fi

mkdir -p "$OUT/graph" "$OUT/map" "$OUT/poi"

# ---- ① OSM 추출 ----
if [[ "$SKIP_EXTRACT" == 1 ]]; then
  echo "[1/7] extract: skipped (--skip-extract)"
else
  echo "[1/7] extract"
  bash "$ROOT/pipeline/osm_extract.sh"
fi
[[ -s "$WORK/nodes.tsv" && -s "$WORK/edges.tsv" ]] || die "그래프 입력 없음: $WORK (osm_extract.sh 실패?)"

# ---- ② 그래프 컴파일 ----
echo "[2/7] graph compile"
if [[ -z "$CARGO_BIN" ]]; then
  if command -v cargo >/dev/null 2>&1; then
    CARGO_BIN=cargo
  elif command -v cargo.exe >/dev/null 2>&1; then
    CARGO_BIN=cargo.exe
  else
    die "cargo 미설치 (CARGO 환경변수로 지정 가능)"
  fi
fi

if [[ "$CARGO_BIN" == *.exe ]]; then
  command -v wslpath >/dev/null 2>&1 || die "WSL 밖에서 cargo.exe 경로 변환 불가 (wslpath 없음)"
  "$CARGO_BIN" run --quiet --manifest-path "$(wslpath -w "$ROOT/core/Cargo.toml")" -p graph-compiler -- \
    --nodes "$(wslpath -w "$WORK/nodes.tsv")" \
    --edges "$(wslpath -w "$WORK/edges.tsv")" \
    --out "$(wslpath -w "$OUT/graph/korea.graph.bin")"
else
  "$CARGO_BIN" run --quiet --manifest-path "$ROOT/core/Cargo.toml" -p graph-compiler -- \
    --nodes "$WORK/nodes.tsv" --edges "$WORK/edges.tsv" --out "$OUT/graph/korea.graph.bin"
fi

# ---- ③ mbtiles ----
echo "[3/7] mbtiles"
bash "$ROOT/pipeline/tiles/build_mbtiles.sh" "$WORK" "$OUT/map/korea.mbtiles"

# ---- ④ POI sqlite ----
echo "[4/7] poi sqlite"
"$PYTHON_BIN" "$ROOT/pipeline/poi/build_poi.py" "$WORK/poi.geojson" "$OUT/poi/korea.poi.sqlite"

# ---- ⑤ 스모크 (실제 팩: GraphFile::open + 경로 1건 + FTS 1건) ----
echo "[5/7] smoke"
if [[ "$CARGO_BIN" == *.exe ]]; then
  "$CARGO_BIN" run --quiet --manifest-path "$(wslpath -w "$ROOT/pipeline/smoke/Cargo.toml")" -- \
    "$(wslpath -w "$OUT")"
else
  "$CARGO_BIN" run --quiet --manifest-path "$ROOT/pipeline/smoke/Cargo.toml" -- "$OUT"
fi

# ---- ⑥ manifest ----
echo "[6/7] manifest"
OSM_DATE_FILE="$WORK/osm_date.txt"
[[ -s "$OSM_DATE_FILE" ]] || die "osm_date 없음: $OSM_DATE_FILE"
"$PYTHON_BIN" "$ROOT/pipeline/manifest.py" "$OUT" \
  --pack-version "$PACK_VERSION" --osm-date "$(tr -d '[:space:]' < "$OSM_DATE_FILE")"

# 이전 팩 대비 총 크기 ±30% 경고 (실패시키지 않는다)
NEW_TOTAL="$("$PYTHON_BIN" - "$OUT/manifest.json" <<'PY'
import json, sys
m = json.load(open(sys.argv[1], encoding="utf-8"))
print(sum(f.get("size", 0) for f in m.get("files", {}).values()))
PY
)"
"$PYTHON_BIN" - "$PREV_TOTAL" "$NEW_TOTAL" <<'PY'
import sys
prev, new = int(sys.argv[1]), int(sys.argv[2])
if prev > 0:
    change = (new - prev) / prev
    if abs(change) > 0.30:
        print(f"WARN: 팩 크기 {prev} -> {new} bytes ({change:+.1%}), ±30% 초과", file=sys.stderr)
    else:
        print(f"size: {prev} -> {new} bytes ({change:+.1%})")
else:
    print(f"size: {new} bytes (이전 팩 없음)")
PY

# ---- ⑦ zip (manifest 포함) ----
echo "[7/7] zip"
ZIP="${OUT%/}.zip"
"$PYTHON_BIN" - "$OUT" "$ZIP" <<'PY'
import pathlib, sys, zipfile

pack, zip_path = pathlib.Path(sys.argv[1]), pathlib.Path(sys.argv[2])
with zipfile.ZipFile(zip_path, "w", zipfile.ZIP_DEFLATED) as z:
    for path in sorted(pack.rglob("*")):
        if not path.is_file():
            continue
        info = zipfile.ZipInfo(str(path.relative_to(pack)), date_time=(1980, 1, 1, 0, 0, 0))
        info.compress_type = zipfile.ZIP_DEFLATED
        z.writestr(info, path.read_bytes())
PY

echo "OK: pack=$OUT zip=$ZIP ($(du -sh "$ZIP" | cut -f1))"
